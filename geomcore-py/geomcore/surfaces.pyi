from typing import Any, List, Optional, Tuple, final

from geomcore import Axis3D, Frame3D, Point3D, Tolerance, Vector3D
from geomcore.curves import Circle3D

@final
class Plane:
    def __new__(cls, point: Point3D, normal: Vector3D) -> Plane: ...
    @staticmethod
    def from_frame(frame: Frame3D) -> Plane: ...
    @staticmethod
    def from_three_points(p1: Point3D, p2: Point3D, p3: Point3D) -> Plane: ...
    @staticmethod
    def from_coefficients(a: float, b: float, c: float, d: float) -> Plane: ...
    def normal(self) -> Vector3D: ...
    def eval_point(self, u: float, v: float) -> Point3D: ...
    def eval_points(self, uvs: List[Tuple[float, float]]) -> List[Point3D]: ...
    def eval_derivative(self, u: float, v: float, du: int, dv: int) -> Vector3D: ...
    def parameters_of(self, point: Point3D) -> Tuple[float, float]: ...
    def contains(self, point: Point3D, tol: Optional[Tolerance] = ...) -> bool: ...
    def project_point(
        self, point: Point3D, tol: Optional[Tolerance] = ...
    ) -> Tuple[float, float, float]: ...
    def project_points(
        self, points: List[Point3D], tol: Optional[Tolerance] = ...
    ) -> List[Tuple[float, float, float]]: ...
    def intersect_plane(self, other: Plane, tol: Optional[Tolerance] = ...) -> Tuple[str, Any]: ...
    def intersect_sphere(self, sphere: Sphere, tol: Optional[Tolerance] = ...) -> Tuple[str, Any]: ...
    def intersect_cylinder(
        self, cylinder: Cylinder, tol: Optional[Tolerance] = ...
    ) -> Tuple[str, Any]: ...
    def intersect_cone(self, cone: Cone, tol: Optional[Tolerance] = ...) -> Tuple[str, Any]: ...

