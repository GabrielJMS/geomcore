@final
class BSplineSurface:
    def __new__(
        cls,
        u_degree: int,
        v_degree: int,
        poles: List[List[Point3D]],
        u_knots: List[float],
        u_multiplicities: List[int],
        v_knots: List[float],
        v_multiplicities: List[int],
        u_periodic: bool,
        v_periodic: bool,
    ) -> BSplineSurface: ...
    @staticmethod
    def new_rational(
        u_degree: int,
        v_degree: int,
        poles: List[List[Point3D]],
        weights: List[List[float]],
        u_knots: List[float],
        u_multiplicities: List[int],
        v_knots: List[float],
        v_multiplicities: List[int],
        u_periodic: bool,
        v_periodic: bool,
    ) -> BSplineSurface: ...
    def u_degree(self) -> int: ...
    def v_degree(self) -> int: ...
    def is_u_periodic(self) -> bool: ...
    def is_v_periodic(self) -> bool: ...
    def is_rational(self) -> bool: ...
    def contains(self, point: Point3D, tol: Optional[Tolerance] = ...) -> bool: ...
    def extrema(
        self, point: Point3D, tol: Optional[Tolerance] = ...
    ) -> List[Tuple[float, float, float]]: ...
    def project_point(
        self, point: Point3D, tol: Optional[Tolerance] = ...
    ) -> Tuple[float, float, float]: ...
    def project_points(
        self, points: List[Point3D], tol: Optional[Tolerance] = ...
    ) -> List[Tuple[float, float, float]]: ...
    def eval_point(self, u: float, v: float) -> Point3D: ...
    def eval_points(self, uvs: List[Tuple[float, float]]) -> List[Point3D]: ...
    def eval_derivative(self, u: float, v: float, du: int, dv: int) -> Vector3D: ...

__all__ = [
    "BSplineSurface",
